@page "/odkrywaj"
@page "/oferty"
@rendermode InteractiveServer
@using ReShareBlazorApp.Api.Date.Enums
@using ReShareBlazorApp.Shared.DTOs
@using ReShareBlazorApp.Web.ApiServices
@using ReShareBlazorApp.Web.Components.Elements
@inject ProductApiService productApi
@inject NavigationManager nav

<PageTitle>Odkrywaj – ODDAJ DALEJ</PageTitle>

<PageHeader Title="Odkrywaj" Subtitle="Przeglądaj ogłoszenia dodane przez innych użytkowników." />

<section class="home-section">
    <div class="home-container page-layout">

        <aside class="page-filters">
            <form method="get" action="/odkrywaj">
                <h2 class="page-filters-title">Filtry</h2>

                <label class="home-field">
                    <span>Czego szukasz?</span>
                    <input type="search" name="q" value="@SearchQuery" placeholder="np. bilety, koncert..." />
                </label>

                <label class="home-field">
                    <span>Kategoria</span>
                    <select name="kategoria">
                        <option value="">Wszystkie</option>
                        <option value="Bilety i rezerwacje" selected="@IsCategoryMatched("bilet", "rezerwac", "tickets")">Bilety i rezerwacje</option>
                        <option value="Wyjazdy i podróże" selected="@IsCategoryMatched("wyjazd", "podróż", "podroz", "trips")">Wyjazdy i podróże</option>
                        <option value="Transport i miejsca" selected="@IsCategoryMatched("transport", "transports")">Transport i miejsca</option>
                        <option value="Usługi i wolne terminy" selected="@IsCategoryMatched("usług", "uslug", "termin", "services")">Usługi i wolne terminy</option>
                    </select>
                </label>

                <label class="home-field">
                    <span>Lokalizacja</span>
                    <input type="text" name="lokalizacja" value="@LocationParam" placeholder="Miejscowość lub kod" />
                </label>

                <div class="page-price-row">
                    <label class="home-field">
                        <span>Cena od</span>
                        <input type="number" name="cenaMin" value="@MinPriceParam" min="0" placeholder="0" />
                    </label>
                    <label class="home-field">
                        <span>Cena do</span>
                        <input type="number" name="cenaMax" value="@MaxPriceParam" min="0" placeholder="1000" />
                    </label>
                </div>

                <button class="home-btn home-btn-primary page-full" type="submit">Zastosuj filtry</button>
                @if (HasActiveFilters)
                {
                    <a class="home-btn home-btn-outline page-full" style="display: block; text-align: center; margin-top: 8px;" href="/odkrywaj">
                        Wyczyść filtry
                    </a>
                }
            </form>
        </aside>

        <div class="page-results">
            <div class="home-section-head page-results-head">
                <p class="page-count">
                    @if (isLoading)
                    {
                        <span>Wyszukiwanie ogłoszeń…</span>
                    }
                    else
                    {
                        <span>Znaleziono @products.Count @GetOgloszeniaSuffix(products.Count)</span>
                    }
                </p>

                <label class="page-sort">
                    <span>Sortuj:</span>
                    <select @bind="selectedSort" @bind:after="ApplySorting">
                        <option value="newest">Najnowsze</option>
                        <option value="price-asc">Cena rosnąco</option>
                        <option value="price-desc">Cena malejąco</option>
                    </select>
                </label>
            </div>

            @if (isLoading)
            {
                <div class="category-loading" style="padding: 60px 0;">
                    <p>Ładowanie wyników…</p>
                </div>
            }
            else if (products.Count == 0)
            {
                <div class="category-empty" style="padding: 60px 0;">
                    <h3>Brak wyników</h3>
                    <p>Nie znaleziono ogłoszeń spełniających podane kryteria.</p>
                    <a class="home-btn home-btn-primary" href="/odkrywaj">Pokaż wszystkie ogłoszenia</a>
                </div>
            }
            else
            {
                <div class="home-cards">
                    @foreach (var product in products)
                    {
                        <ListingCard Title="@product.Name"
                                     Category="@GetCategoryDisplayName(product.Category)"
                                     Type="Sprzedam"
                                     Price="@(product.Price == 0 ? "Bezpłatnie" : $"{product.Price:N2} zł")"
                                     Location="Polska"
                                     Term="@product.ExpiresAt.ToString("dd.MM.yyyy")"
                                     Published="@product.AddedAt.ToString("dd.MM.yyyy")"
                                     Link="@($"/ogloszenie/{product.Id}")" />
                    }
                </div>
            }
        </div>
    </div>
</section>

<SiteFooter />

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "kategoria")]
    public string? CategoryParam { get; set; }

    [SupplyParameterFromQuery(Name = "typ")]
    public string? TypeParam { get; set; }

    [SupplyParameterFromQuery(Name = "lokalizacja")]
    public string? LocationParam { get; set; }

    [SupplyParameterFromQuery(Name = "od")]
    public string? DateFromParam { get; set; }

    [SupplyParameterFromQuery(Name = "do")]
    public string? DateToParam { get; set; }

    [SupplyParameterFromQuery(Name = "cenaMin")]
    public decimal? MinPriceParam { get; set; }

    [SupplyParameterFromQuery(Name = "cenaMax")]
    public decimal? MaxPriceParam { get; set; }

    private List<ProductDTO> products = new();
    private bool isLoading = true;
    private string selectedSort = "newest";

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(SearchQuery) ||
        !string.IsNullOrWhiteSpace(CategoryParam) ||
        !string.IsNullOrWhiteSpace(LocationParam) ||
        MinPriceParam.HasValue ||
        MaxPriceParam.HasValue ||
        !string.IsNullOrWhiteSpace(DateFromParam) ||
        !string.IsNullOrWhiteSpace(DateToParam);

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        var category = MapCategory(CategoryParam);
        DateTime? dateFrom = DateTime.TryParse(DateFromParam, out var d1) ? d1 : null;
        DateTime? dateTo = DateTime.TryParse(DateToParam, out var d2) ? d2 : null;

        try
        {
            products = await productApi.GetProductsAsync(
                number: 50,
                category: category,
                query: SearchQuery,
                minPrice: MinPriceParam,
                maxPrice: MaxPriceParam,
                dateFrom: dateFrom,
                dateTo: dateTo);

            ApplySorting();
        }
        catch
        {
            products = new List<ProductDTO>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplySorting()
    {
        products = selectedSort switch
        {
            "price-asc" => products.OrderBy(p => p.Price).ToList(),
            "price-desc" => products.OrderByDescending(p => p.Price).ToList(),
            _ => products.OrderByDescending(p => p.AddedAt).ToList()
        };
    }

    private bool IsCategoryMatched(params string[] keywords)
    {
        if (string.IsNullOrWhiteSpace(CategoryParam))
            return false;

        var lower = CategoryParam.ToLowerInvariant();
        return keywords.Any(k => lower.Contains(k.ToLowerInvariant()));
    }

    private static ProductCategory? MapCategory(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        var v = value.Trim().ToLowerInvariant();
        if (v.Contains("bilet") || v.Contains("rezerwac") || v == "tickets" || v == "reservations" || v == "bilety-i-rezerwacje")
            return ProductCategory.Tickets;
        if (v.Contains("wyjazd") || v.Contains("podróż") || v.Contains("podroz") || v.Contains("nocleg") || v == "trips" || v == "wyjazdy-i-podroze")
            return ProductCategory.Trips;
        if (v.Contains("transport") || v.Contains("miejsc") || v == "transports" || v == "transport-i-miejsca")
            return ProductCategory.Transports;
        if (v.Contains("usług") || v.Contains("uslug") || v.Contains("termin") || v == "services" || v == "uslugi-i-wolne-terminy")
            return ProductCategory.Services;
        if (Enum.TryParse<ProductCategory>(value, true, out var result))
            return result;
        return null;
    }

    private static string GetCategoryDisplayName(ProductCategory category) => category switch
    {
        ProductCategory.Tickets => "Bilety i rezerwacje",
        ProductCategory.Reservations => "Rezerwacje",
        ProductCategory.Trips => "Wyjazdy i podróże",
        ProductCategory.Transports => "Transport i miejsca",
        ProductCategory.Services => "Usługi i wolne terminy",
        _ => category.ToString()
    };

    private static string GetOgloszeniaSuffix(int count)
    {
        if (count == 1) return "ogłoszenie";
        if (count >= 2 && count <= 4) return "ogłoszenia";
        if (count >= 5 && count <= 21) return "ogłoszeń";
        var lastDigit = count % 10;
        if (lastDigit >= 2 && lastDigit <= 4) return "ogłoszenia";
        return "ogłoszeń";
    }
}
